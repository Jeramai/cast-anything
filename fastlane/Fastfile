# Store-upload lane for the bare (non-EAS) build, ported from the auction/cadence
# pipeline. Uploads the artifact produced by `npm run build:android:store`:
#   Android -> ./app-release.aab
# Run via `npm run submit:android`.

ANDROID_AAB = "./app-release.aab".freeze

platform :android do
  desc "Upload the release .aab to the Play Store internal track"
  lane :submit do
    # Service-account JSON for the Google Play Developer API. Provide the path via
    # GOOGLE_PLAY_JSON_KEY. This app is under the personal (gameout-501508) Play
    # account, so use gameout's revenuecat-key.json — the auction key has no access.
    upload_to_play_store(
      track: "internal",
      aab: ANDROID_AAB,
      json_key: ENV.fetch("GOOGLE_PLAY_JSON_KEY"),
      release_status: "completed",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Upload the full main store listing (title, descriptions, icon, feature graphic,"
  desc "phone screenshots) — no binary, no release notes, no track/rollout change."
  lane :update_listing do
    upload_to_play_store(
      json_key: ENV.fetch("GOOGLE_PLAY_JSON_KEY"),
      track: "internal",                 # resolve against the existing vc 5 release
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: false,       # title + short/full description
      skip_upload_changelogs: true,      # leave release notes untouched
      skip_upload_images: false,         # icon.png + featureGraphic.png
      skip_upload_screenshots: false     # phoneScreenshots/*
    )
  end

  desc "Stage the existing vc 5 build on the Closed testing (alpha) track as a DRAFT,"
  desc "with release notes. No new binary, internal track untouched, nothing rolled out."
  lane :closed_testing do
    upload_to_play_store(
      json_key: ENV.fetch("GOOGLE_PLAY_JSON_KEY"),
      track: "alpha",                    # Play's "Closed testing" track
      version_code: 5,                   # release the already-uploaded bundle
      release_status: "draft",           # stage only; you roll out from the Console
      deactivate_on_promote: false,      # keep the internal release active
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,        # listing text already published
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false      # attach changelogs/5.txt as the release notes
    )
  end
end
