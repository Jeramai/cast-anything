{
  "expo": {
    "name": "Cast Anything",
    "slug": "Cast-anything",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "castanything",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.castanything.app",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Cast Anything finds TVs and media players on your Wi-Fi network so you can cast media to them.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      },
      "entitlements": {
        "com.apple.developer.networking.multicast": true
      }
    },
    "android": {
      "package": "com.castanything.app",
      "adaptiveIcon": {
        "backgroundColor": "#edf4ff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font",
      [
        "@howincodes/expo-dynamic-app-icon",
        {
          "blue": {
            "ios": "./assets/icons/blue.png",
            "android": {
              "foregroundImage": "./assets/icons/blue-fg.png",
              "backgroundColor": "#edf4ff"
            }
          },
          "indigo": {
            "ios": "./assets/icons/indigo.png",
            "android": {
              "foregroundImage": "./assets/icons/indigo-fg.png",
              "backgroundColor": "#eff0fe"
            }
          },
          "violet": {
            "ios": "./assets/icons/violet.png",
            "android": {
              "foregroundImage": "./assets/icons/violet-fg.png",
              "backgroundColor": "#f3effe"
            }
          },
          "fuchsia": {
            "ios": "./assets/icons/fuchsia.png",
            "android": {
              "foregroundImage": "./assets/icons/fuchsia-fg.png",
              "backgroundColor": "#fbedfd"
            }
          },
          "pink": {
            "ios": "./assets/icons/pink.png",
            "android": {
              "foregroundImage": "./assets/icons/pink-fg.png",
              "backgroundColor": "#fdedf5"
            }
          },
          "rose": {
            "ios": "./assets/icons/rose.png",
            "android": {
              "foregroundImage": "./assets/icons/rose-fg.png",
              "backgroundColor": "#fff1f3"
            }
          },
          "red": {
            "ios": "./assets/icons/red.png",
            "android": {
              "foregroundImage": "./assets/icons/red-fg.png",
              "backgroundColor": "#fdecec"
            }
          },
          "firebrick": {
            "ios": "./assets/icons/firebrick.png",
            "android": {
              "foregroundImage": "./assets/icons/firebrick-fg.png",
              "backgroundColor": "#f7e9e9"
            }
          },
          "orange": {
            "ios": "./assets/icons/orange.png",
            "android": {
              "foregroundImage": "./assets/icons/orange-fg.png",
              "backgroundColor": "#fff4ec"
            }
          },
          "amber": {
            "ios": "./assets/icons/amber.png",
            "android": {
              "foregroundImage": "./assets/icons/amber-fg.png",
              "backgroundColor": "#fff9e9"
            }
          },
          "lime": {
