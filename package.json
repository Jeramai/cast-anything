    "@dr.pogodin/react-native-static-server": "^0.26.2",
    "@expo/vector-icons": "^15.0.2",
    "@howincodes/expo-dynamic-app-icon": "^3.0.2",
    "@wokcito/ffmpeg-kit-react-native": "^6.1.2",
    "buffer": "^6.0.3",
    "expo": "~56.0.9",
    "expo-build-properties": "~56.0.17",
    "expo-clipboard": "~56.0.4",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.7",
    "expo-font": "~56.0.5",
    "expo-keep-awake": "~56.0.3",
    "expo-media-library": "~56.0.6",
    "expo-network": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "fast-xml-parser": "^5.8.0",
    "fflate": "^0.8.3",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-tcp-socket": "^6.4.1",
    "react-native-udp": "^4.1.7"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "~19.2.2",
    "bun-types": "^1.3.14",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "build:android:store": "bash scripts/build-android-store.sh",
    "submit:android": "bash scripts/submit-android.sh",
    "icons": "bun scripts/gen-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:types": "tsc -p tsconfig.test.json"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-udp",
          "react-native-tcp-socket"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
