# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
# ios/ is regenerated by `expo prebuild` from app.json (entitlements + Info.plist
# all live there), so it stays ignored.
/ios
# android/ is COMMITTED: it carries hand-tuned bits `expo prebuild` would clobber
# (the release signing config in app/build.gradle that reads credentials/, the
# jitpack repo, etc.). Only its build output is ignored — see below. The build
# runs gradlew directly (scripts/build-android-store.sh), never prebuild.
/android/.gradle/
/android/.kotlin/
/android/build/
/android/app/build/
/android/app/.cxx/
/android/.cxx/
/android/local.properties
/android/.idea/
*.hprof

# local Expo module native build output (the module sources stay tracked)
modules/**/build/
modules/**/.cxx/
modules/**/.gradle/

# personal Claude Code settings (shared settings.json stays tracked)
.claude/settings.local.json

# Release signing key + passwords (Play Store upload). NEVER commit.
/credentials/

# Built store artifacts (produced by scripts/build-android-store.sh)
/app-release.aab
*.aab
*.apk
